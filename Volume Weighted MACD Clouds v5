toLen(x) =>
    math.max(1, int(math.round(x)))

ma(_src, _length, _maType) =>
    switch _maType
        "EMA" => ta.ema(_src, _length)
        "SMA" => ta.sma(_src, _length)

macdPack(_src, _fast, _slow, _sig, _oscType, _sigType) =>
    f = toLen(_fast)
    s = toLen(_slow)
    g = toLen(_sig)
    fast = ma(_src, f, _oscType)
    slow = ma(_src, s, _oscType)
    m = fast - slow
    sg = ma(m, g, _sigType)
    h = m - sg
    [m, sg, h]

histStateColor(_hist) =>
    _hist >= 0 ? (_hist > _hist[1] ? colPosRise : colPosFall) : (_hist > _hist[1] ? colNegRise : colNegFall)

anchor = ta.vwma(vwmaSrc, toLen(vwmaLen * cloudTfMult))

macdMult1 = cloudTfMult
macdMult2 = mult2 * cloudTfMult
macdMult3 = mult3 * cloudTfMult
macdMult4 = mult4 * cloudTfMult
macdMult5 = mult5 * cloudTfMult
macdMult6 = mult6 * cloudTfMult

// MACD1..6 (multiplier derived)
[m1, s1, h1] = macdPack(sourceInput, fastLenInput * macdMult1, slowLenInput * macdMult1, sigLenInput * macdMult1, oscTypeInput, sigTypeInput)
[m2, s2, h2] = macdPack(sourceInput, fastLenInput * macdMult2, slowLenInput * macdMult2, sigLenInput * macdMult2, oscTypeInput, sigTypeInput)
[m3, s3, h3] = macdPack(sourceInput, fastLenInput * macdMult3, slowLenInput * macdMult3, sigLenInput * macdMult3, oscTypeInput, sigTypeInput)
[m4, s4, h4] = macdPack(sourceInput, fastLenInput * macdMult4, slowLenInput * macdMult4, sigLenInput * macdMult4, oscTypeInput, sigTypeInput)
[m5, s5, h5] = macdPack(sourceInput, fastLenInput * macdMult5, slowLenInput * macdMult5, sigLenInput * macdMult5, oscTypeInput, sigTypeInput)
[m6, s6, h6] = macdPack(sourceInput, fastLenInput * macdMult6, slowLenInput * macdMult6, sigLenInput * macdMult6, oscTypeInput, sigTypeInput)

m1Px = anchor + m1, s1Px = anchor + s1, h1Px = anchor + h1
