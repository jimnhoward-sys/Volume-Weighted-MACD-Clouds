seriesByName(_name) =>
    switch _name
        "MACD1" => m1Px
        "Signal1" => s1Px
        "MACD2" => m2Px
        "Signal2" => s2Px
        "MACD3" => m3Px
        "Signal3" => s3Px
        "MACD4" => m4Px
        "Signal4" => s4Px
        "MACD5" => m5Px
        "Signal5" => s5Px
        "MACD6" => m6Px
        "Signal6" => s6Px
        "Close" => close
        "Open" => open
        => anchor

offsetByName(_name) =>
    switch _name
        "MACD1" => lineOffset1
        "Signal1" => lineOffset1
        "MACD2" => lineOffset2
        "Signal2" => lineOffset2
        "MACD3" => lineOffset3
        "Signal3" => lineOffset3
        "MACD4" => lineOffset4
        "Signal4" => lineOffset4
        "MACD5" => lineOffset5
        "Signal5" => lineOffset5
        "MACD6" => lineOffset6
        "Signal6" => lineOffset6
        "Close" => 0
        "Open" => 0
        => vwmaOffset

mirrorOp(_op) =>
    _op == ">" ? "<" : _op == "<" ? ">" : _op == "Crosses Above" ? "Crosses Below" : "Crosses Above"

evalCond(_l, _op, _r, _isShort) =>
    opUse = _isShort ? mirrorOp(_op) : _op
    leftV = seriesByName(_l)
    rightBase = seriesByName(_r)
    leftOffset = offsetByName(_l)
    rightOffset = offsetByName(_r)
    shiftBars = rightOffset - leftOffset
    rightV = shiftBars >= 0 ? rightBase[shiftBars] : na
    opUse == ">" ? leftV > rightV : opUse == "<" ? leftV < rightV : opUse == "Crosses Above" ? ta.crossover(leftV, rightV) : ta.crossunder(leftV, rightV)

combineConds(_logic, _count, _c1, _c2, _c3, _c4, _c5, _c6, _c7, _c8, _c9, _c10) =>
    useAnd = _logic == "AND"
