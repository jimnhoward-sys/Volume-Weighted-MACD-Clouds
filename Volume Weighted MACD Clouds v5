    if showAllCandles and showGroupedCandles and not na(gcOpen)
        gcPrevUp = gcClose >= gcOpen
        gcPrevBody = gcPrevUp ? gcBullBody : gcBearBody
        gcPrevBorder = gcPrevUp ? gcBullBorder : gcBearBorder
        box.new(gcStart, math.max(gcOpen, gcClose), bar_index - 1, math.min(gcOpen, gcClose), border_color=gcPrevBorder, bgcolor=gcPrevBody)
        wickX = int(math.floor((gcStart + bar_index - 1) / 2))
        line.new(wickX, gcHigh, wickX, gcLow, color=gcPrevBorder, width=1)
    gcStart := bar_index
    gcOpen := open
    gcHigh := high
    gcLow := low
    gcClose := close
else
    gcHigh := math.max(gcHigh, high)
    gcLow := math.min(gcLow, low)
    gcClose := close

var box gcRtBody = na
var line gcRtWick = na
if barstate.islast
    if showAllCandles and showGroupedCandles and not na(gcOpen)
        gcRtUp = gcClose >= gcOpen
        gcRtBodyColor = gcRtUp ? gcBullBody : gcBearBody
        gcRtBorder = gcRtUp ? gcBullBorder : gcBearBorder
        if na(gcRtBody)
            gcRtBody := box.new(gcStart, math.max(gcOpen, gcClose), bar_index, math.min(gcOpen, gcClose), border_color=gcRtBorder, bgcolor=gcRtBodyColor)
        else
            box.set_left(gcRtBody, gcStart)
            box.set_right(gcRtBody, bar_index)
            box.set_top(gcRtBody, math.max(gcOpen, gcClose))
            box.set_bottom(gcRtBody, math.min(gcOpen, gcClose))
            box.set_border_color(gcRtBody, gcRtBorder)
            box.set_bgcolor(gcRtBody, gcRtBodyColor)
        rtWickX = int(math.floor((gcStart + bar_index) / 2))
        if na(gcRtWick)
            gcRtWick := line.new(rtWickX, gcHigh, rtWickX, gcLow, color=gcRtBorder, width=1)
        else
            line.set_xy1(gcRtWick, rtWickX, gcHigh)
            line.set_xy2(gcRtWick, rtWickX, gcLow)
            line.set_color(gcRtWick, gcRtBorder)
    else
        if not na(gcRtBody)
            box.set_bgcolor(gcRtBody, na)
            box.set_border_color(gcRtBody, na)
        if not na(gcRtWick)
            line.set_color(gcRtWick, na)

